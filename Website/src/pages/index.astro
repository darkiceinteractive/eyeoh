---
import BaseLayout from '../layouts/BaseLayout.astro';
import pkg from '../../package.json';
import '../../launch.css';

const downloadURL = import.meta.env.PUBLIC_DOWNLOAD_URL ?? '/downloads/EyeOh.dmg';
const origin = 'https://eyeoh.app';
const description = 'Switch microphones, speakers and your preferred camera from the Mac menu bar. Free and open source for macOS 14 and later.';
const faqs = [
  { question: 'Will my meeting app follow EyeOh?', answer: 'Set the microphone and speaker in Zoom, Teams or your other meeting app to System or Default. For cameras, EyeOh sets the macOS preference. Some apps keep their own camera choice.' },
  { question: 'Can EyeOh reconnect Bluetooth devices?', answer: 'Yes. If a paired headset has appeared in EyeOh before, it can stay in the menu with a Connect action when disconnected. Turn it on and keep it nearby.' },
  { question: 'Does it record anything?', answer: 'EyeOh never records audio or video. Camera preview is optional and stops when you close it. This release sends no app analytics or crash reports.' },
  { question: 'Is it free and open source?', answer: 'Yes. The official Mac download is free and the core is available under the MIT licence. It works on Apple silicon and Intel Macs running macOS 14 or later.' },
];
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'EyeOh', description,
  url: `${origin}/`, operatingSystem: 'macOS 14+', applicationCategory: 'UtilitiesApplication',
  softwareVersion: pkg.version, downloadUrl: `${origin}/downloads/EyeOh.dmg`,
  screenshot: `${origin}/assets/eyeoh-demo-menu.webp`, license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' },
  publisher: { '@type': 'Organization', name: 'Dark Ice Interactive', url: 'https://darkice.au/' },
}];
---

<BaseLayout title="EyeOh — Switch your Mac’s mic, speakers and camera" description={description} jsonLd={jsonLd}>
  <div class="launch">
    <section class="container launch-hero" aria-labelledby="launch-title">
      <div class="launch-intro">
        <p class="launch-kicker"><span></span> A free Mac menu bar app</p>
        <h1 id="launch-title">Your mic, speakers<br class="launch-break" /> and camera.<br class="launch-break" /> <em>One menu.</em></h1>
        <p class="launch-lede">Switch devices from the Mac menu bar. See what’s selected before a call, reconnect your headphones, and put the right camera back in play.</p>
        <div class="launch-actions">
          <a class="button button-primary launch-download" href={downloadURL} data-download>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14" /></svg>
            Download for Mac
          </a>
          <a class="launch-link" href="#features">See how it works <span aria-hidden="true">↘</span></a>
        </div>
        <p class="launch-release">Free · Version 0.5.1 · macOS 14 or later</p>
      </div>

      <figure class="launch-hero-figure">
        <div class="launch-stage launch-stage-main">
          <div class="launch-stage-top"><span>EyeOh for macOS</span><span><i></i> Demo setup</span></div>
          <a href="/assets/eyeoh-demo-menu.webp" aria-label="Open the full EyeOh menu screenshot">
            <img class="launch-menu-shot" src="/assets/eyeoh-demo-menu.webp" width="351" height="798" alt="EyeOh’s native Mac menu showing the Sony WH-1000XM5 selected for input and output, a C920 camera, and Connect actions for paired Bluetooth devices" fetchpriority="high" />
          </a>
          <div class="launch-stage-bottom"><span>Input</span><span>Output</span><span>Camera</span></div>
        </div>
        <figcaption>EyeOh on macOS, using a sample device setup.</figcaption>
      </figure>
    </section>

    <div class="container launch-facts" aria-label="Download details">
      <span>Apple silicon + Intel</span><span>Signed and notarized</span><span>No account or driver</span><span>MIT-licensed core</span>
    </div>

    <span id="why" aria-hidden="true"></span>
    <section class="container launch-workflow" id="features" aria-labelledby="features-title">
      <div class="launch-workflow-copy">
        <p class="launch-kicker"><span></span> Built for a desk that changes</p>
        <h2 id="features-title">When a device drops out, you can see what happened.</h2>
        <dl class="launch-feature-list">
          <div><dt>Reconnect a paired headset</dt><dd>Previously used Bluetooth devices stay in the menu with a Connect action. Reconnect and select the route in one step.</dd></div>
          <div><dt>Keep a preferred camera</dt><dd>If your webcam is unplugged, EyeOh shows the camera currently selected. It can restore your preferred camera when it comes back.</dd></div>
          <div><dt>Keep your volume where you left it</dt><dd>Set output volume from the menu, restore remembered levels for supported devices, and mute your mic before you speak.</dd></div>
        </dl>
      </div>
      <figure class="launch-unplugged">
        <div class="launch-stage launch-stage-detail">
          <div class="launch-stage-top"><span>Webcam unplugged</span><span><i></i> Demo setup</span></div>
          <a href="/assets/eyeoh-demo-unplugged.webp" aria-label="Open the full unplugged-camera screenshot">
            <img src="/assets/eyeoh-demo-unplugged.webp" width="573" height="750" alt="EyeOh demo with a MacBook camera selected, the preferred C920 listed as disconnected, and two paired Bluetooth devices ready to reconnect" loading="lazy" />
          </a>
        </div>
        <figcaption>The MacBook camera is available while the C920 is unplugged.</figcaption>
      </figure>
    </section>

    <section class="launch-install" id="install" aria-labelledby="install-title">
      <div class="container launch-install-grid">
        <div>
          <p class="launch-kicker"><span></span> Set up in three steps</p>
          <h2 id="install-title">From download to menu bar.</h2>
          <a class="button button-primary launch-download" href={downloadURL} data-download>Download for Mac</a>
        </div>
        <ol>
          <li><span>01</span><div><strong>Open the DMG</strong><p>Drag EyeOh into Applications.</p></div></li>
          <li><span>02</span><div><strong>Launch EyeOh</strong><p>Find the EyeOh icon in your Mac’s menu bar.</p></div></li>
          <li><span>03</span><div><strong>Choose a device</strong><p>Pick an input, output or preferred camera. Set meeting apps to System or Default for audio.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="container launch-questions" id="faq" aria-labelledby="faq-title">
      <div>
        <p class="launch-kicker"><span></span> Good to know</p>
        <h2 id="faq-title">A few quick answers.</h2>
        <a class="launch-link" href="/support/">Help and contact <span aria-hidden="true">↗</span></a>
      </div>
      <div>
        {faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </section>
  </div>
</BaseLayout>
